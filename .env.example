# =============================================================================
# HOSTINGER VPS ENVIRONMENT VARIABLES CONFIGURATION
# Copy to .env on your VPS (cp .env.example .env) and fill in your values
# =============================================================================

# Server Port & Environment
PORT=3000
NODE_ENV="production"

# Local VPS Persistent Data & File Storage Directories
# Keep DATA_DIR & STORAGE_DIR outside temporary/build folders (e.g. /var/lib/tgbot/data & /var/lib/tgbot/files
# or ./data & ./storage/files) so restarts, rebuilds, and code updates never wipe your records or files.
DATA_DIR="./data"
STORAGE_DIR="./storage/files"
DATA_FILE_PATH=""

# Telegram Bot Token from @BotFather (BOT_TOKEN or TELEGRAM_BOT_TOKEN)
BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Telegram User ID of the primary owner / root administrator (ADMIN_ID or ROOT_ADMIN_ID)
ADMIN_ID="8153757163"
ROOT_ADMIN_ID="8153757163"

# Administrator Web Login Credentials
ADMIN_NAME="admin"
ADMIN_PASSWORD="your_admin_secure_password"
ADMIN_EMAIL="sohanrahman07565@gmail.com"

# Secret key used for signing session tokens & cookies (set a strong random 32+ char string)
SESSION_SECRET=""

# Public Domain & Webhook Settings for Hostinger VPS (e.g. https://bot.yourdomain.com)
APP_URL=""
BASE_URL=""
WEBHOOK_URL=""

# Optional: Gemini API Key for AI features
GEMINI_API_KEY=""

# Self-Hosted Free Fire Guest Account Bancheck API (.env)
FF_GUEST_UID=""
FF_GUEST_PASSWORD=""
FF_GUEST_TOKEN=""
FF_GUEST_OPEN_ID=""
FF_GUEST_LOGIN_URL=""
FF_GUEST_PLAYER_URL=""
LOCAL_FF_API_PORT="3000"
FF_BANCHECK_API_URL=""

# Optional: Custom External Bancheck API / Optional MTProto Bridge
BANCHECK_API_URL=""
BANCHECK_API_KEY=""
BANCHECK_MTPROTO_BRIDGE_URL=""
BANCHECK_MTPROTO_BRIDGE_KEY=""
TELEGRAM_MTPROTO_API_ID=""
TELEGRAM_MTPROTO_API_HASH=""
TELEGRAM_MTPROTO_SESSION=""
BANCHECK_MTPROTO_BOT=""

# Optional: Free Fire Banner API & Banner/Avatar Asset Directories / Custom CDN Templates ({id})
BANNER_API_URL=""
BANNER_API_KEY=""
BANNER_ASSETS_DIR=""
AVATAR_ASSETS_DIR=""
FF_BANNER_CDN_URL=""
FF_AVATAR_CDN_URL=""

# Optional: Custom Free Fire Like API Endpoint (used if set; otherwise Garena guest login + Free Fire LikeProfile is used directly)
FF_LIKE_API_URL=""
FF_LIKE_API_KEY=""
