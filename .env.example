# =============================================================================
# RENDER WEB SERVICE ENVIRONMENT VARIABLES CONFIGURATION
# Configure these variables in your Render Dashboard (Environment tab)
# =============================================================================

# Telegram Bot Token from @BotFather (BOT_TOKEN or TELEGRAM_BOT_TOKEN)
BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Telegram User ID of the primary owner / root administrator (ADMIN_ID or ROOT_ADMIN_ID)
ADMIN_ID="8153757163"
ROOT_ADMIN_ID="8153757163"

# Administrator Web Login Credentials
ADMIN_NAME="admin"
ADMIN_PASSWORD="your_admin_secure_password"
ADMIN_EMAIL="sohanrahman07565@gmail.com"

# Web Service Port (Render sets process.env.PORT automatically)
PORT=10000

# Environment Mode
NODE_ENV="production"

# Secret key used for signing session cookies
SESSION_SECRET="your-secure-session-secret-at-least-32-chars"

# Optional persistent storage path (defaults to .data/store.json)
DATA_FILE_PATH=".data/store.json"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: Public URL where this web service is hosted
APP_URL=""
